*","purl":"pkg:npm/com.unity.feature.2d@2.0.0","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.feature.2d/package.json"}]},{"bom-ref":"pkg:npm/com.unity.feature.ar@1.0.1?package-id=a7ab22aa59d9f425","type":"library","name":"com.unity.feature.ar","version":"1.0.1","description":"Create rich, deeply engaging augmented reality experiences with Unity’s AR Feature Set.  The AR Feature Set provides a starting point for augmented reality development, spanning from head-mounted displays to mobile.","cpe":"cpe:2.3:a:com.unity.feature.ar:com.unity.feature.ar:1.0.1:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.feature.ar@1.0.1","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.feature.ar/package.json"}]},{"bom-ref":"pkg:npm/com.unity.feature.characters-animation@1.0.0?package-id=34768a5470fe4ea0","type":"library","name":"com.unity.feature.characters-animation","version":"1.0.0","description":"Animate characters and create cutscenes with the Characters and Animation feature set.\n\nBuild interactive character rigs and constraints to animate characters and GameObjects.\nArrange tracks and clips to create gameplay sequences, cutscenes, or movies.\nOrchestrate, shoot, and record beautiful narratives for cutscenes or movies.\nEasily round-trip to your 3D modeling software","cpe":"cpe:2.3:a:com.unity.feature.characters-animation:com.unity.feature.characters-animation:1.0.0:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.feature.characters-animation@1.0.0","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.characters-animation:com.unity.feature.characters_animation:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.characters_animation:com.unity.feature.characters-animation:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.characters_animation:com.unity.feature.characters_animation:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.characters:com.unity.feature.characters-animation:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.characters:com.unity.feature.characters_animation:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.feature.characters-animation/package.json"}]},{"bom-ref":"pkg:npm/com.unity.feature.cinematic@1.0.0?package-id=9c2046c6a2e30126","type":"library","name":"com.unity.feature.cinematic","version":"1.0.0","description":"Create films, TV shows, and other animated linear content. Organize and assemble your assets in structured sequences. Automate complex camera movements. Export data for round-trip and review, and output your final cut. Work with common film industry formats.","cpe":"cpe:2.3:a:com.unity.feature.cinematic:com.unity.feature.cinematic:1.0.0:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.feature.cinematic@1.0.0","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.feature.cinematic/package.json"}]},{"bom-ref":"pkg:npm/com.unity.feature.development@1.0.1?package-id=1503a24abe643a16","type":"library","name":"com.unity.feature.development","version":"1.0.1","description":"Optimize your development experience in Unity with the Dev Tools feature set. Enable support for multiple integrated development environments (IDE) for editing your Unity code. Get access to development tools to help you test and analyze your project’s performance.","cpe":"cpe:2.3:a:com.unity.feature.development:com.unity.feature.development:1.0.1:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.feature.development@1.0.1","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.feature.development/package.json"}]},{"bom-ref":"pkg:npm/com.unity.feature.gameplay-storytelling@1.0.0?package-id=7425787640d38b03","type":"library","name":"com.unity.feature.gameplay-storytelling","version":"1.0.0","description":"Bring your project to life with the easy-to-use story creation features provided in the Gameplay and Storytelling feature set.\nArrange cinematic content and audiovisual sequences with Timeline.\nLeverage Cinemachine to quickly setup the right dynamic camera shots.\nUse Visual Scripting to connect it all together with intuitive, node-based graphs.","cpe":"cpe:2.3:a:com.unity.feature.gameplay-storytelling:com.unity.feature.gameplay-storytelling:1.0.0:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.feature.gameplay-storytelling@1.0.0","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.gameplay-storytelling:com.unity.feature.gameplay_storytelling:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.gameplay_storytelling:com.unity.feature.gameplay-storytelling:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.gameplay_storytelling:com.unity.feature.gameplay_storytelling:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.gameplay:com.unity.feature.gameplay-storytelling:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:cpe23","value":"cpe:2.3:a:com.unity.feature.gameplay:com.unity.feature.gameplay_storytelling:1.0.0:*:*:*:*:*:*:*"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.feature.gameplay-storytelling/package.json"}]},{"bom-ref":"pkg:npm/com.unity.feature.mobile@1.0.0?package-id=e2e0646c2b973cc1","type":"library","name":"com.unity.feature.mobile","version":"1.0.0","description":"Optimize your apps for mobile devices and provide a performant experience for your users. Includes utilities for debugging on device and support for notifications.