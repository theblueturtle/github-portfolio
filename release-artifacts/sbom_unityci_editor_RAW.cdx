:"1.0.0.0","cpe":"cpe:2.3:a:unity_technologies:com_unity_ugui_.net:1.0.0.0:*:*:*:*:*:*:*","purl":"pkg:nuget/com.unity.ugui@1.0.0.0","properties":[{"name":"syft:package:foundBy","value":"dotnet-deps-binary-cataloger"},{"name":"syft:package:language","value":"dotnet"},{"name":"syft:package:type","value":"dotnet"},{"name":"syft:package:metadataType","value":"dotnet-portable-executable-entry"},{"name":"syft:cpe23","value":"cpe:2.3:a:unity_technologies:com_unity_ugui:1.0.0.0:*:*:*:*:*:*:*"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/ProjectTemplates/libcache/com.unity.template.universal-2d-2.1.2/ScriptAssemblies/UnityEditor.UI.dll"}]},{"bom-ref":"pkg:npm/com.unity.ui@2.0.0?package-id=81c2130e3facc7ab","type":"library","name":"com.unity.ui","version":"2.0.0","description":"UI Toolkit is a set of features, resources and tools for developing user interfaces (UI). Use it to develop custom UI and extensions for the Unity Editor, runtime debugging tools, and runtime UI for games and applications.\\r\\n\\r\\nUI Toolkit includes:\\r\\n\\r\\n\\u25aa A retained-mode UI system, based on recognized web technologies, that supports stylesheets, and dynamic and contextual event handling.\\r\\n\\u25aa UXML and USS asset types for building and styling user interfaces. These are inspired by standard web technologies such as XML, HTML, and CSS.\\r\\n\\u25aa Tools and resources such as a built-in UI debugger, the support for the UI Builder visual UI authoring tool, and examples available in the editor.","cpe":"cpe:2.3:a:com.unity.ui:com.unity.ui:2.0.0:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.ui@2.0.0","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.ui/package.json"}]},{"bom-ref":"pkg:npm/com.unity.ui.builder@2.0.0?package-id=d2e14ef6810e0cc4","type":"library","name":"com.unity.ui.builder","version":"2.0.0","description":"The UI Builder lets you visually create and edit UI assets such as UI documents (.uxml files), and stylesheets (.uss files), that you use with Unity's UI Toolkit (formerly UIElements).\\n\\nTo open the UI Builder window, select Window > UI Toolkit > UI Builder from the menu.\\n\\nNote: In Unity 2019.x, you open the UI Builder from the Window > UI > UI Builder menu.\\n\\nNote: UI Builder is the visual authoring tool for UI Toolkit. For details, please see the UI Builder package documentation.","cpe":"cpe:2.3:a:com.unity.ui.builder:com.unity.ui.builder:2.0.0:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.ui.builder@2.0.0","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.ui.builder/package.json"}]},{"bom-ref":"pkg:npm/com.unity.visualeffectgraph@14.0.11?package-id=3a28c4a4deca5069","type":"library","name":"com.unity.visualeffectgraph","version":"14.0.11","description":"The Visual Effect Graph is a node based visual effect editor. It allows you to author next generation visual effects that Unity simulates directly on the GPU. The Visual Effect Graph is production-ready for the High Definition Render Pipeline and runs on all platforms supported by it. Full support for the Universal Render Pipeline and compatible mobile devices is still in development.","licenses":[{"license":{"name":"sha256:9899fd517324c1c4b8725d56f69d78b81b1a64f5ee603cdd8ee9f1fe2a5f0dd5"}},{"license":{"name":"sha256:b7caa3106944ad4afb756c84faa0bcdbe2c8a72c87d31dfb006956485fcae5cf"}}],"cpe":"cpe:2.3:a:com.unity.visualeffectgraph:com.unity.visualeffectgraph:14.0.11:*:*:*:*:*:*:*","purl":"pkg:npm/com.unity.visualeffectgraph@14.0.11","properties":[{"name":"syft:package:foundBy","value":"javascript-package-cataloger"},{"name":"syft:package:language","value":"javascript"},{"name":"syft:package:type","value":"npm"},{"name":"syft:package:metadataType","value":"javascript-npm-package"},{"name":"syft:location:0:layerID","value":"sha256:3e48a4e07801c65e67bf7ca4743d8de67f1595771cb06ee3ebc6ad742a402a7c"},{"name":"syft:location:0:path","value":"/opt/unity/Editor/Data/Resources/PackageManager/BuiltInPackages/com.unity.visualeffectgraph/package.json"}]},{"bom-ref":"pkg:deb/ubuntu/coreutils@8.32-4.1ubuntu1?arch=amd64&distro=ubuntu-22.04&package-id=4a06c4b25fce84d0","type":"library","publisher":"Ubuntu Developers <ubuntu-devel-discuss@lists.ubuntu.com>","name":"coreutils","version":"8.32-4.1ubuntu1","licenses":[{"license":{"id":"BSD-3-Clause"}},{"license":{"id":"GFDL-1.2-no-invariants-or-later"}},{"license":{"id":"GPL-3.0-or-later"}},{"license":{"id":"ISC"}}],"cpe":"cpe:2.3:a:coreutils:coreutils:8.32-4.1ubuntu1:*:*:*:*:*:*:*","purl":"pkg:deb/ubuntu/coreutils@8.32-4.1ubuntu1?arch=amd64&distro=ubuntu-22.04","properties":[{"name":"syft:package:foundBy","value":"dpkg-db-cataloger"},{"name":"syft:package:type","value":"deb"},{"name":"syft:package:metadataType","value":"dpkg-db-entry"},{"name":"syft:location:0:layerID","value":"sha256:3ccb255e5448ebe0c4b15b1a6482a4fac6a76ca24018ecd7074e95546c36cd03"},{"name":"syft:location:0:path","value":"/var/lib/dpkg/status"},{"name":"syft:location:1:layerID","value":"sha256:a1360aae5271bbbf575b4057cb4158dbdfbcae76